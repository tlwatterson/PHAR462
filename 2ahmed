<script>

let explored = {

    beliefs:false,
    goals:false,
    fears:false,
    treatments:false,
    support:false,
    communication:false

};

function showScene(id){

    document.querySelectorAll(".scene")
    .forEach(scene => scene.classList.remove("active"));

    document.getElementById(id)
    .classList.add("active");

    updateProgress();

}

function unlock(area){

    explored[area] = true;

    updateProgress();

}

function updateProgress(){

    const p = document.getElementById("progress");

    if(!p) return;

    p.innerHTML = `
    ...
    `;
}


function determineEnding(){

    let score = 0;

    if(explored.beliefs) score++;
    if(explored.goals) score++;
    if(explored.fears) score++;
    if(explored.treatments) score++;
    if(explored.support) score++;
    if(explored.communication) score++;

    if(score <= 2){
        showScene("endingClinical");
    }
    else if(score <= 4){
        showScene("endingShared");
    }
    else{
        showScene("endingPartnership");
    }

}


window.onload = function(){

    updateProgress();

}

